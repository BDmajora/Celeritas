impetus.options.texture_filtering.trilinear=Trilinear
impetus.options.hidden_fluid_culling.name=Hidden Fluid Culling
impetus.options.hidden_fluid_culling.tooltip=Skips rendering fluid faces that are fully hidden by neighbouring blocks, reducing overdraw. Recommended.
impetus.options.improved_fluid_shaping.name=Improved Fluid Shaping
impetus.options.improved_fluid_shaping.tooltip=Uses alternative corner-height sampling for smoother-looking fluid surfaces.
impetus.options.closest_point_entity_sort.name=Enhanced Entity Sorting
impetus.options.closest_point_entity_sort.tooltip=Sorts translucent entities by their closest point rather than their centre, reducing sorting errors for large entities.
impetus.options.defer_chunk_updates.name=Defer Chunk Updates
impetus.options.defer_chunk_updates.zero=None
impetus.options.defer_chunk_updates.one=One Frame

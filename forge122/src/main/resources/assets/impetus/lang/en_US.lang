impetus.options.pixel_filtering.name=Pixel Filtering
impetus.options.pixel_filtering.tooltip=Controls how the block atlas is magnified. Sharp keeps the classic nearest-neighbour pixel look; Smooth applies linear interpolation between texels.
impetus.options.pixel_filtering.nearest=Sharp
impetus.options.pixel_filtering.linear=Smooth

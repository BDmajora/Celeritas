impetus.options.inactivity_fps_limit.minimized=Minimized
impetus.options.quad_splitting.name=Quad Splitting
impetus.options.quad_splitting.tooltip=Uses exact BSP ordering for translucent geometry within a chunk, eliminating most translucency sorting artifacts at a small meshing cost. When disabled, a faster centroid distance sort is used.
impetus.options.quad_splitting.disabled=Disabled
impetus.options.quad_splitting.enabled=Enabled

impetus.options.fullscreen.resolution.tooltip=Controls the resolution of the game in fullscreen mode.
impetus.options.fullscreen.resolution.name=Fullscreen Resolution
impetus.options.fullscreen.resolution.disabled_tooltip=Fullscreen resolution selection is not available on this 1.12.2 windowing backend.
impetus.options.fullscreen.resolution.value=Current

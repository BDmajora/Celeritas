#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#import <impetus:mesh/scene.glsl>
#import <impetus:mesh/vertex_format.glsl>

// Phase 3, part two: quads to triangles.
//
// One thread per quad, sixteen per meshlet. Each thread loads its four vertices through a raw pointer, projects
// them, drops either triangle that lands entirely between pixel centres, and then the subgroup does a prefix sum
// to work out where everyone writes. No index buffer, no attribute fetch, no per-vertex shader invocation.
//
// The fragment shader re-fetches the vertices it needs by quad id, so nothing is interpolated across the
// task/mesh boundary except position.

layout(local_size_x = 16) in;
layout(triangles, max_vertices = 64, max_primitives = 32) out;

taskNV in Task {
    vec3 origin;
    uint baseOffset;
    uint quadCount;

    uvec4 rangeEndA;
    uvec4 rangeEndB;
    uvec4 rangeStartA;
    uvec4 rangeStartB;
};

// Maps this thread's position in the meshlet to a quad in the arena, walking the ranges the task shader kept.
// Threads in a workgroup almost always land in the same range, so the branch is uniform in practice.
uint resolveQuad() {
    uint index = gl_GlobalInvocationID.x;

    if (index < rangeEndA.x) { return rangeStartA.x + index + baseOffset; }
    if (index < rangeEndA.y) { return rangeStartA.y + (index - rangeEndA.x) + baseOffset; }
    if (index < rangeEndA.z) { return rangeStartA.z + (index - rangeEndA.y) + baseOffset; }
    if (index < rangeEndA.w) { return rangeStartA.w + (index - rangeEndA.z) + baseOffset; }
    if (index < rangeEndB.x) { return rangeStartB.x + (index - rangeEndA.w) + baseOffset; }
    if (index < rangeEndB.y) { return rangeStartB.y + (index - rangeEndB.x) + baseOffset; }
    if (index < rangeEndB.z) { return rangeStartB.z + (index - rangeEndB.y) + baseOffset; }
    if (index < rangeEndB.w) { return rangeStartB.w + (index - rangeEndB.z) + baseOffset; }

    return uint(-1);
}

vec4 project(Vertex v) {
    return MVP * vec4(decodeVertexPosition(v) + origin, 1.0);
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        gl_PrimitiveCountNV = 0;
    }

    uint quad = resolveQuad();

    if (quad == uint(-1)) {
        return;
    }

    // Vertices 0 and 2 are the diagonal shared by both triangles of the quad.
    Vertex v0 = terrainData[(quad << 2) + 0u];
    Vertex v1 = terrainData[(quad << 2) + 1u];
    Vertex v2 = terrainData[(quad << 2) + 2u];
    Vertex v3 = terrainData[(quad << 2) + 3u];

    vec4 p0 = project(v0);
    vec4 p1 = project(v1);
    vec4 p2 = project(v2);
    vec4 p3 = project(v3);

    bool drawT0;
    bool drawT1;

    {
        // Screen-space bounds of each triangle. If a triangle's bounds round to the same pixel in both x and y
        // it cannot cover a pixel centre, so rasterizing it would produce nothing. Culling it here is far
        // cheaper than letting the rasterizer discover that, and at distance most triangles are in this state.
        vec2 shared0 = ((p0.xy / p0.w) + 1.0) * screenSize;
        vec2 shared2 = ((p2.xy / p2.w) + 1.0) * screenSize;

        vec2 sharedMin = min(shared0, shared2);
        vec2 sharedMax = max(shared0, shared2);

        vec2 point = ((p1.xy / p1.w) + 1.0) * screenSize;
        drawT0 = all(notEqual(round(min(sharedMin, point)), round(max(sharedMax, point))));

        point = ((p3.xy / p3.w) + 1.0) * screenSize;
        drawT1 = all(notEqual(round(min(sharedMin, point)), round(max(sharedMax, point))));
    }

    if (!(drawT0 || drawT1)) {
        return;
    }

    // Prefix sums over the subgroup give every surviving thread its slice of the meshlet's vertex and primitive
    // arrays without an atomic or a barrier.
    uint triangles = uint(drawT0) + uint(drawT1);
    uint triIndex = subgroupExclusiveAdd(triangles);
    uint vertBase = subgroupExclusiveAdd((drawT0 == drawT1) ? 4u : 3u);
    uint totalTriangles = subgroupMax(triIndex + triangles);

    uint indexCursor = triIndex * 3u;
    uint vertCursor = vertBase;

    gl_MeshVerticesNV[vertCursor++].gl_Position = p0;
    gl_MeshVerticesNV[vertCursor++].gl_Position = p2;

    // Everything the fragment shader needs beyond position, packed into the primitive id: the quad to re-fetch,
    // the mip bias, the alpha cutoff selector, and which of the two triangles this is.
    uint lodBias = hasMipmapping(v0) ? 0u : 1u;
    int payload = int((lodBias << 2) | rawAlphaCutoff(v0) | (quad << 4));

    if (drawT0) {
        gl_MeshVerticesNV[vertCursor].gl_Position = p1;
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 0u;
        gl_PrimitiveIndicesNV[indexCursor++] = vertCursor;
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 1u;
        vertCursor++;

        gl_MeshPrimitivesNV[triIndex++].gl_PrimitiveID = payload | (0 << 3);
    }

    if (drawT1) {
        gl_MeshVerticesNV[vertCursor].gl_Position = p3;
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 1u;
        gl_PrimitiveIndicesNV[indexCursor++] = vertCursor;
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 0u;
        vertCursor++;

        gl_MeshPrimitivesNV[triIndex++].gl_PrimitiveID = payload | (1 << 3);
    }

    if (subgroupElect()) {
        gl_PrimitiveCountNV = totalTriangles;
    }
}

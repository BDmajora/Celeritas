#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require

#import <impetus:mesh/scene.glsl>

// Phase 2, part two: one box per section, sized to the section's actual geometry rather than the full 16 cubed.
// A tight box is what lets a section behind a wall fail the depth test; a full-chunk box would poke through and
// stay visible forever.

#define BOX_EXPAND 0.1

layout(local_size_x = 8) in;
layout(triangles, max_vertices = 8, max_primitives = 12) out;

taskNV in Task {
    uint32_t visibilityBase;
    uint32_t sectionBase;
    ivec3 chunkShift;
};

const uint TRI_A[] = {0, 3, 6, 0, 1, 7, 4, 5};
const uint TRI_B[] = {1, 2, 6, 4, 0, 7, 6, 4};
const uint TRI_C[] = {2, 0, 4, 5, 1, 3, 7, 2};
const uint TRI_D[] = {1, 2, 0, 5, 5, 1, 7, 7};
const uint TRI_E[] = {6, 2, 3, 7};

void main() {
    int visibilityIndex = int(visibilityBase | gl_WorkGroupID.x);

    // Last frame's visibility byte, carried into the primitive payload so the fragment shader can shift it and
    // keep a short history without reading the array twice.
    uint8_t previous = sectionVisibility[visibilityIndex];

    ivec4 header = sectionData[sectionBase | gl_WorkGroupID.x].header;

    if (sectionEmpty(header) || (header.y & (1 << 17)) != 0) {
        if (gl_LocalInvocationID.x == 0u) {
            sectionVisibility[visibilityIndex] = uint8_t(0);
            gl_PrimitiveCountNV = 0;
        }
        return;
    }

    // Bounding box in 1-block cells within the section.
    vec3 mins = vec3(header.xyz & 0xF) - BOX_EXPAND;
    vec3 maxs = mins + vec3((header.xyz >> 4) & 0xF) + 1.0 + (BOX_EXPAND * 2.0);

    // Chunk y is stored in 9 bits; shift it to the top of the word and back to sign-extend.
    ivec3 chunk = ivec3(header.xyz) >> 8;
    chunk.y &= 0x1FF;
    chunk.y = (chunk.y << 23) >> 23;

    vec3 origin = vec3((chunk + chunkShift) << 4);

    vec3 corner = origin + vec3(
        ((gl_LocalInvocationID.x & 1u) == 0u) ? mins.x : maxs.x,
        ((gl_LocalInvocationID.x & 4u) == 0u) ? mins.y : maxs.y,
        ((gl_LocalInvocationID.x & 2u) == 0u) ? mins.z : maxs.z
    );

    gl_MeshVerticesNV[gl_LocalInvocationID.x].gl_Position = MVP * vec4(corner, 1.0);

    // Payload: which section this is, plus last frame's history already shifted up one place. The fragment
    // shader only has to store the low byte.
    int payload = (visibilityIndex << 8) | int((uint(previous) << 1) & 0xFFu) | 1;

    uint base = gl_LocalInvocationID.x << 2;
    gl_PrimitiveIndicesNV[base | 0u] = TRI_A[gl_LocalInvocationID.x];
    gl_PrimitiveIndicesNV[base | 1u] = TRI_B[gl_LocalInvocationID.x];
    gl_PrimitiveIndicesNV[base | 2u] = TRI_C[gl_LocalInvocationID.x];
    gl_PrimitiveIndicesNV[base | 3u] = TRI_D[gl_LocalInvocationID.x];
    gl_MeshPrimitivesNV[gl_LocalInvocationID.x].gl_PrimitiveID = payload;

    if (gl_LocalInvocationID.x < 4u) {
        gl_PrimitiveIndicesNV[32u + gl_LocalInvocationID.x] = TRI_E[gl_LocalInvocationID.x];
        gl_MeshPrimitivesNV[gl_LocalInvocationID.x + 8u].gl_PrimitiveID = payload;
    }

    if (gl_LocalInvocationID.x == 0u) {
        // Same reasoning as the region box: depth testing cannot resolve a box the camera is standing in.
        vec3 minPos = mins + origin + subChunkOffset.xyz;
        vec3 maxPos = maxs + origin + subChunkOffset.xyz;
        bool cameraInside = all(lessThan(minPos, vec3(BOX_EXPAND))) && all(lessThan(vec3(-BOX_EXPAND), maxPos));

        sectionVisibility[visibilityIndex] = uint8_t(uint(previous) << 1) | uint8_t(cameraInside ? 1 : 0);
        gl_PrimitiveCountNV = 12;
    }
}

#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require

#import <impetus:mesh/scene.glsl>

// Phase 3, part one: decide which quads of a section are worth meshing, and how many meshlets that needs.
//
// This is where backface culling happens, per section rather than per triangle. Quads are grouped by facing at
// build time, so "is the camera on the +X side of this section" answers whether the entire +X group can be
// skipped. Six comparisons replace a per-triangle winding test.
//
// One workgroup per section; gl_TaskCountNV meshlets are launched, each covering MESH_WORKLOAD quads.

#define MESH_WORKLOAD 16

layout(local_size_x = 1) in;

taskNV out Task {
    // Section origin relative to the camera's section, in blocks.
    vec3 origin;
    // First quad of this section in the geometry arena.
    uint baseOffset;
    // Total quads the meshlets will cover.
    uint quadCount;

    // The surviving quad ranges, as a running index and a source offset each. A meshlet thread finds its quad by
    // walking these: at most eight comparisons, and every thread in a workgroup takes the same branch.
    uvec4 rangeEndA;
    uvec4 rangeEndB;
    uvec4 rangeStartA;
    uvec4 rangeStartB;
};

void appendRange(inout uint slot, inout uint runningIndex, uint offset, uint length) {
    uint id = slot++;

    if (id < 4u) {
        rangeEndA[id] = runningIndex + length;
        rangeStartA[id] = offset;
    } else {
        rangeEndB[id - 4u] = runningIndex + length;
        rangeStartB[id - 4u] = offset;
    }

    runningIndex += length;
}

// ranges holds eight uint16 quad COUNTS. They are accumulated here into absolute offsets, which is what lets a
// section hold more quads than a 16-bit absolute offset could address.
void selectRanges(ivec3 relativeChunk, uvec4 ranges) {
    uint slot = 0u;
    uint runningIndex = 0u;

    rangeEndA = uvec4(0);
    rangeEndB = uvec4(0);

    // Slot 7 is the section's own base quad within its allocation.
    uint cursor = (ranges.w >> 16) & 0xFFFFu;

    // Slots 0..5 are POS_X, POS_Y, POS_Z, NEG_X, NEG_Y, NEG_Z, in the order the mesher groups them.
    // A section at or west of the camera shows its +X faces, and so on; the >= and <= overlap deliberately so a
    // section level with the camera on an axis keeps both of its faces on that axis.
    uint length = ranges.x & 0xFFFFu;
    if (relativeChunk.x <= 0 && length > 0u) { appendRange(slot, runningIndex, cursor, length); }
    cursor += length;

    length = (ranges.x >> 16) & 0xFFFFu;
    if (relativeChunk.y <= 0 && length > 0u) { appendRange(slot, runningIndex, cursor, length); }
    cursor += length;

    length = ranges.y & 0xFFFFu;
    if (relativeChunk.z <= 0 && length > 0u) { appendRange(slot, runningIndex, cursor, length); }
    cursor += length;

    length = (ranges.y >> 16) & 0xFFFFu;
    if (relativeChunk.x >= 0 && length > 0u) { appendRange(slot, runningIndex, cursor, length); }
    cursor += length;

    length = ranges.z & 0xFFFFu;
    if (relativeChunk.y >= 0 && length > 0u) { appendRange(slot, runningIndex, cursor, length); }
    cursor += length;

    length = (ranges.z >> 16) & 0xFFFFu;
    if (relativeChunk.z >= 0 && length > 0u) { appendRange(slot, runningIndex, cursor, length); }
    cursor += length;

    // Unassigned quads have no single facing, so they are always drawn.
    appendRange(slot, runningIndex, cursor, ranges.w & 0xFFFFu);

    quadCount = runningIndex;
    gl_TaskCountNV = (runningIndex + MESH_WORKLOAD - 1u) / MESH_WORKLOAD;
}

void main() {
    uint sectionId = gl_WorkGroupID.x;

    // Bit 0 of the visibility byte is this frame's result from the section rasterizer, written LAST frame.
    if ((sectionVisibility[sectionId] & uint8_t(1)) == uint8_t(0)) {
        gl_TaskCountNV = 0;
        return;
    }

    ivec4 header = sectionData[sectionId].header;

    ivec3 chunk = ivec3(header.xyz) >> 8;
    chunk.y &= 0x1FF;
    chunk.y = (chunk.y << 23) >> 23;
    chunk -= cameraChunk.xyz;

    origin = vec3(chunk << 4);
    baseOffset = uint(header.w);

    selectRanges(chunk, uvec4(sectionData[sectionId].renderRanges));
}
